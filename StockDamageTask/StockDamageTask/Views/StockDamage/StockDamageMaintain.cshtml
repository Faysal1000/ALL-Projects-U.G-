@{
    ViewBag.Title = "StockDamageMaintain";

    // here i am converting viewbag data to json so i can use it inside jquery
    var currenciesJson = Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.Currency);
    var employeesJson = Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.Employees);
    var godownsJson = Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.Godowns);
    var stocksJson = Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.Stocks);
    var stockDamagesJson = Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.StockDamages);
    var subItemCodesJson = Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.SubItemCodes);
}
<!-- here adding the jquery from online and also the bootstrap icon-->
<script src="https://code.jquery.com/jquery-3.7.1.min.js"
        integrity="sha256-/JqT3SQfawRcv/BIHPThkBvs0OEvtFFmqPF/lYI/Cxo="
        crossorigin="anonymous"></script>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">


<div class="card bg-body">
    <div class="card-header bg-secondary text-white p-2">
        <h4 class="mb-0">Stock Damage</h4>
    </div>

    <form id="stockDamageForm" class="small">
        <div class="card-body">
            <div class="row">
                <div class="col-12 col-md-6">

                    <div class="row mb-1">
                        <label for="date" class="col-3 col-form-label">Date</label>
                        <input type="date" id="date" class="col-4 col-form-control border-0 border-bottom">
                        <button type="button" class="btn btn-outline-secondary btn-sm col-1">
                            <i class="bi bi-search"></i>
                        </button>
                    </div>

                    <div class="row mb-1">
                        <label for="voucherNo" class="col-3 col-form-label">Voucher No</label>
                        <input type="text" id="voucherNo" class="col-4 col-form-control border-1"
                               placeholder="Auto generated Voucher Number" value="">
                        <button type="button" id="searchWithVoucher" class="btn btn-outline-secondary btn-sm col-1">
                            <i class="bi bi-search"></i>
                        </button>
                    </div>

                    <div class="row mb-1">
                        <label for="warehouseName" class="col-3 col-form-label">Warehouse Name</label>
                        <select id="warehouseName" class="col-9 col-form-control border-1">
                            <option value="">Select Warehouse</option>
                            @foreach (var godown in ViewBag.Godowns)
                            {
                                <option value="@godown.GodownNo">@godown.GodownName</option>
                            }
                        </select>
                    </div>

                    <div class="row mb-1">
                        <label for="itemName" class="col-3 col-form-label">Item Name</label>
                        <select id="itemName" class="col-9 col-form-control border-1">
                            <option value="">Select Item</option>
                            @foreach (var item in ViewBag.subItemCodes)
                            {
                                <option value="@item.SubItemName">@item.SubItemName</option>
                            }
                        </select>
                    </div>

                    <div class="row mb-1">
                        <label class="col-3 col-form-label">Item Code</label>
                        <input type="text" id="itemCode" class="col-form-control form-control-sm col-3" readonly>

                        <label class="col-1 col-form-label">Unit</label>
                        <input type="text" id="unit" class="col-form-control form-control-sm col-2" readonly>

                        <label class="col-2 col-form-label">Weight</label>
                        <input type="text" id="weight" class="col-form-control form-control-sm col-1" readonly>
                    </div>

                    <div class="row mb-1">
                        <label class="col-3 col-form-label">Batch No</label>
                        <input type="text" id="batchNo" class="col-form-control form-control-sm col-5" value="NA">

                        <label class="col-1 col-form-label">Stock</label>
                        <input type="text" id="stock" class="col-form-control form-control-sm col-3" readonly>
                    </div>
                </div>

                <div class="col-12 col-md-6">
                    <div class="row mb-1 ms-2">
                        <label for="currency" class="col-3 col-form-label">Currency</label>
                        <select id="currency" class="col-9 col-form-control border-1">
                            <option value="">Select Currency</option>
                            @foreach (var curr in ViewBag.Currency)
                            {
                                <option value="@curr.CurrencyName">@curr.CurrencyName</option>
                            }
                        </select>
                    </div>

                    <div class="row mb-1 ms-2">
                        <label for="quantity" class="col-3 col-form-label">Quantity</label>
                        <input type="number" min="0" step="1" id="quantity" class="col-4 col-form-control">

                        <label for="rate" class="col-2 col-form-label">Rate</label>
                        <input type="number" id="rate" class="col-3 col-form-control">
                    </div>

                    <div class="row mb-1 ms-2">
                        <label for="amount_in" class="col-3 col-form-label">Amount in</label>
                        <input type="number" id="amount_in" class="col-9 col-form-control">
                    </div>

                    <div class="row mb-1 ms-2">
                        <label for="exchangeRate" class="col-3 col-form-label">Exchange Rate(in BDT)</label>
                        <input type="number" id="exchangeRate" class="col-4 col-form-control" readonly>

                        <label for="totalAmount" class="col-2 col-form-label">Total Amount</label>
                        <input type="number" id="totalAmount" class="col-3 col-form-control" disabled>
                    </div>

                    <div class="row mb-1 ms-2">
                        <label for="DrACHead" class="col-3 col-form-label">Dr A/C Head</label>
                        <select id="DrACHead" class="col-9 col-form-control border-1">
                            <option value="Stock Damage">Stock Damage</option>
                        </select>
                    </div>

                    <div class="row mb-1 ms-2">
                        <label for="employee" class="col-3 col-form-label">Employee Name</label>
                        <select id="employee" class="col-9 col-form-control border-1">
                            <option value="">Select Your Name</option>
                            @foreach (var emp in ViewBag.Employees)
                            {
                                <option value="@emp.EmployeeId">@emp.EmployeeName</option>
                            }
                        </select>
                    </div>

                    <div class="row mb-1 ms-2">
                        <label for="comments" class="col-3 col-form-label">Comments</label>
                        <textarea id="comments" class="col-form-control col-9" rows="2"></textarea>
                    </div>
                </div>
            </div>
        </div>

        <button type="button" id="add" class="btn btn-light border btn-sm ms-3 mb-2">
            <i class="bi bi-plus"></i> Add
        </button>
    </form>
</div>

<div class="mt-3 bg-body">
    <table id="damageTable" class="table table-bordered table-hover">
        <thead class="bg-white">
            <tr>
                <th>SL#</th>
                <th>Warehouse Name</th>
                <th>Item Name</th>
                <th>Item Code</th>
                <th>Batch No</th>
                <th>Currency</th>
                <th>Quantity</th>
                <th>Rate</th>
                <th>Amount (in BDT)</th>
                <th>Exchange Rate (in BDT)</th>
                <th>Total Amount</th>
                <th>Edit</th>
                <th>Delete</th>
            </tr>
        </thead>
        <tbody>
            @{
                int slNo = 1;
            }
            @if (ViewBag.StockDamages != null && ((List<StockDamageTask.DTOs.StockDamageDTO>)ViewBag.StockDamages).Count > 0)
            {
                foreach (var damageRecord in ViewBag.StockDamages)
                {
                    <tr>
                        <td>@slNo</td>
                        <td>@damageRecord.WarehouseName</td>
                        <td>@damageRecord.ItemName</td>
                        <td>@damageRecord.ItemCode</td>
                        <td>@damageRecord.BatchNo</td>
                        <td>@damageRecord.Currency</td>
                        <td>@damageRecord.Quantity</td>
                        <td>@damageRecord.Rate</td>
                        <td>@damageRecord.Amount_in</td>
                        <td>@damageRecord.ExchangeRate</td>
                        <td>@damageRecord.TotalAmount</td>
                        <td>
                            <button type="button" class="btn btn-sm btn-warning editRow">
                                <i class="bi bi-pencil"></i>
                            </button>
                        </td>
                        <td>
                            <button type="button" class="btn btn-sm btn-danger deleteRow">
                                <i class="bi bi-trash"></i>
                            </button>
                        </td>
                        <td class="d-none">@damageRecord.VoucherNo</td> <!-- here this Hidden column -->
                    </tr>
                    slNo++;
                }
            }
            else
            {
                <tr class="noData">
                    <td colspan="13" class="text-center">No data found</td>
                </tr>
            }
        </tbody>

    </table>
</div>

<div class="d-flex justify-content-end align-items-center mt-3 bg-body p-2 mt-4">
    <label for="grandTotal" class="form-label mb-0 me-5">Total Amount</label>
    <input type="number" id="grandTotal" class="form-control" style="width: 250px;" readonly value="0">
</div>

<button type="button" id="saveButton" class="btn btn-light border btn-sm ms-3 mb-2">
    <i class="bi bi-save"></i> Save
</button>


<script>
    /* This script sets the item value automatically to its box
        it will trigger when the select item name option is changed
    */
    // getting the data from c# to jquery
    var subItemCodes = @Html.Raw(subItemCodesJson);
    var stocks = @Html.Raw(stocksJson);

    $('#itemName').change(function () {
        var itemNameValue = $(this).val();

        if (!itemNameValue) {
            $('#itemCode').val('');
            $('#unit').val('');
            $('#weight').val(0);
            $('#stock').val(0);
            return;
        }
        // finding the selected sub item object to retrive their details along with stock quantity
        var selectedItem = subItemCodes.find(x => x.SubItemName == itemNameValue);
        var stock = stocks.find(x => x.SubItemCode === selectedItem.SubItemCode)

        // finally setting the data
        if (selectedItem) {
            $('#itemCode').val(selectedItem.SubItemCode);
            $('#unit').val(selectedItem.Unit);
            $('#weight').val(selectedItem.Weight);
            $('#stock').val(stock?.Quantity ?? 0);
        } else {
            $('#itemCode').val('');
            $('#unit').val('');
            $('#weight').val(0);
            $('#stock').val(0);
        }
    });
</script>

<script>
    // this script is responsible for selecting the currency conversion value automatically
    var currencies = @Html.Raw(currenciesJson);

    $("#currency").change(function () {
        var currencyValue = $(this).val();
        if (!currencyValue) {
            $('#exchangeRate').val('').trigger('input');
            return;
        }

        var selectedCurrencyObject = currencies.find(x => x.CurrencyName == currencyValue);
        $('#exchangeRate').val(selectedCurrencyObject?.ConversionRate ?? 0).trigger('input');
    });
</script>

<script>
    // function to calculate total where it will get quantity, item rate and the exchange rate
    // all three multiplication = totalAmount
    function calculateTotal() {
        var quantity = parseInt($('#quantity').val()) || 0;
        var itemRate = parseFloat($('#rate').val()) || 0;
        var exchangeRate = parseFloat($('#exchangeRate').val()) || 0;

        var totalAmount = quantity * itemRate * exchangeRate;
        $('#totalAmount').val(totalAmount.toFixed(3));
    }

    // if any of the value is changed it will recalculate and display
    $('#quantity, #rate, #exchangeRate').on('input', calculateTotal);
    $('#currency').change(calculateTotal);
</script>


<script>
    // this fucntion is for showing the grand total of the tables total amount
    function updateGrandTotal() {
        var grandTotal = 0;
        $('#damageTable tbody tr').each(function () {
            var row = $(this);
            //skip row if it has class 'table-danger' means it is edited
            if (row.hasClass('table-danger')) {
                return; 
            }
            var total = parseFloat(row.find('td:eq(10)').text()) || 0;
            grandTotal += total;
        });
        $('#grandTotal').val(grandTotal.toFixed(3));
    }

    // after the document ready the gradtotal will be calculated and show
    $(document).ready(function () {
        updateGrandTotal();
    });

    // this fucntion will clear the input fields
    function clearInputs() {
        $('#itemCode, #quantity, #amount_in, #rate, #unit, #weight, #exchangeRate, #totalAmount, #comments, #voucherNo').val('');
        $('#warehouseName').prop('selectedIndex', 0);
        $('#itemName').prop('selectedIndex', 0);
        $('#currency').prop('selectedIndex', 0);
        $('#employee').prop('selectedIndex', 0);
        $('#DrACHead').prop('selectedIndex', 0);
        $('#batchNo').val('NA');
    }

    // this function will generate temporay id to trac which entries got changed
    function generateTempId() {
        return 'temp_' + Date.now() + '_' + Math.floor(Math.random() * 1000);
    }
</script>

<script>
    var stockDamageList = [];  // this will temporarily hold the object before saving to db

    $('#add').click(function () {
        // checking if user inserted more than the stock value
        var stockQuantity = $('#stock').val();
        var quantity = $('#quantity').val();
        if (stockQuantity - quantity < 0) {
            alert("Invalid data!. You can't insert quantity more than the stock");
            return;
        }

        var tempId = generateTempId(); // temp id generation while adding the data

        // here getting all the fields data to view in the table
        var warehouseName = $('#warehouseName option:selected').text();
        var itemName = $('#itemName').val();
        var itemCode = $('#itemCode').val();
        var batchNo = $('#batchNo').val();
        var currency = $('#currency').val();
        var amount_in = $('#amount_in').val();
        var rate = $('#rate').val();
        var exchangeRate = $('#exchangeRate').val();
        var totalAmount = $('#totalAmount').val();

        //extra details for sending in server side to save
        var drACHead = $('#DrACHead').val();
        var employeeId = $('#employee').val();
        var comments = $('#comments').val();
        var godownNo = $('#warehouseName').val();
        var voucherNo = $('#voucherNo').val();

        // if any of the necessary field is missing then it will give alert
        if (!warehouseName || !itemName || !currency || !quantity ||
            !amount_in || !rate || !exchangeRate || !employeeId || !employeeId) {
            alert('Please fill all required fields before adding.');
            return;
        }

        //  this will remove old object if editing a temporary row
        // means if it is already edited one time and user is editing again
        // then it will remove the previous edit to ensure not saving 2 times
        if (editingRow && editingRow.data('id')) {
            var oldId = editingRow.data('id');
            stockDamageList = stockDamageList.filter(x => x.TempId !== oldId);
        }

        // after adding data, if the table has no data previously then that sms will be deleted
        $('#damageTable tbody tr.noData').remove();

        // here getting the next serial number
        // total row in the table +1 is the next serial number
        var slNo = $('#damageTable tbody tr').length + 1;

        // writing html to append the table row
        var newRow = `
           <tr data-id="${tempId}" class="table-success">
                <td>${slNo}</td>
                <td>${warehouseName}</td>
                <td>${itemName}</td>
                <td>${itemCode}</td>
                <td>${batchNo}</td>
                <td>${currency}</td>
                <td>${quantity}</td>
                <td>${rate}</td>
                <td>${totalAmount}</td>
                <td>${exchangeRate}</td>
                <td>${totalAmount}</td>
                <td><button type="button" class="btn btn-sm btn-warning editRow"><i class="bi bi-pencil"></i></button></td>
                <td><button type="button" class="btn btn-sm btn-danger deleteRow"><i class="bi bi-trash"></i></button></td>
                <td class="d-none">${voucherNo}</td> <!-- Hidden column here -->
            </tr>`;

        //here appending the row data to the table also recalculating the gradtotal of the table data
        //and also clearing the fields
        $('#damageTable tbody').append(newRow);
        updateGrandTotal();
        clearInputs();


        //creating object to store added details in the temporary list
        var stockDamageObj = {
            TempId: tempId,
            VoucherNo: voucherNo,
            GodownNo: godownNo,
            ItemName: itemName,
            ItemCode: itemCode,
            BatchNo: (!batchNo || batchNo == 'NA' || isNaN(parseInt(batchNo))) ? 0 : parseInt(batchNo),
            CurrencyName: currency,
            ConversionRate: parseFloat(exchangeRate) || 0,
            StockQuantity: parseInt(stockQuantity) || 0,
            Quantity: parseInt(quantity) || 0,
            Rate: parseFloat(rate) || 0,
            Amount_in: parseFloat(amount_in) || 0,
            TotalAmount: parseFloat(totalAmount) || 0,
            DrACHead: drACHead || "Stock Damage",
            EmployeeId: parseInt(employeeId) || 0,
            CreatedDate: new Date(),
            Comments: comments || ""
        };

        stockDamageList.push(stockDamageObj);
        //console.log(JSON.stringify(stockDamageList, null, 2)); // debugging to see if any error
        $('#voucherNo').prop('disabled', false); //user can't change voucher while editing but afterward they can
    });
</script>

<script>
    // similarly here all the delete id will be stored before actually deleting
    var deletedVouchers = [];

    $(document).on('click', '.deleteRow', function () {
        var confirmDelete = confirm("Are you sure you want to delete this row?");
        if (confirmDelete) {
            var row = $(this).closest('tr');

            // if it has temp id then just delete from the list
            var tempId = row.data('id');
            if (tempId) {
                stockDamageList = stockDamageList.filter(x => x.TempId !== tempId);
            }

            // if it has voucerNo, then need to store it cause it need to delete from db
            var voucherNo = row.find('td:last').text();
            if (voucherNo) {
                deletedVouchers.push(voucherNo);
            }

            row.remove();

            // after deleting it is recalculating the serial number so it remains consistense
            $('#damageTable tbody tr').each(function (index) {
                $(this).find('td:eq(0)').text(index + 1);
            });

            updateGrandTotal(); // again after deleting the table grandtotal need to be recalculated
        }
    });

</script>

<script>
    // this script will handle edit
    // it basically took details from table and set them to their respective fields
    var editingRow = null;

    $(document).on('click', '.editRow', function () {
        var row = $(this).closest('tr');
        editingRow = row;
        row.addClass('table-danger'); // editing table will be shown red
        $(this).prop('disabled', true); // also second time edit is cancelled as user will add the edit back again

        // this will find warehousename form godownNo and select that option
        var warehouseNameText = row.find('td:eq(1)').text();
        $('#warehouseName option').filter(function () {
            return $(this).text() == warehouseNameText;
        }).prop('selected', true);

        // similarly other value will be sent to tehir respective field
        // some field need to be retrigger to make sure it will get auto data
        $('#itemName').val(row.find('td:eq(2)').text());
        $('#itemName')[0].dispatchEvent(new Event('change'));

        $('#itemCode').val(row.find('td:eq(3)').text());
        $('#batchNo').val(row.find('td:eq(4)').text());
        $('#currency').val(row.find('td:eq(5)').text());
        $('#quantity').val(row.find('td:eq(6)').text());
        $('#rate').val(row.find('td:eq(7)').text());
        $('#amount_in').val(row.find('td:eq(8)').text());
        $('#exchangeRate').val(row.find('td:eq(9)').text());
        $('#totalAmount').val(row.find('td:eq(10)').text());

        // employee details will reset as the emply details will be calculated again
        $('#employee').prop('selectedIndex', 0);
        $('#DrACHead').prop('selectedIndex', 0);

        // if the table has voucher no then make sure the user can't edit it
        // so later it will update the current entries in the database without adding new
        var voucherNo = row.find('td:last').text();
        if (voucherNo) {
            $('#voucherNo').val(voucherNo);
            $('#voucherNo').prop('disabled', true);
        }
        //this will recalculate the total again removing the diting row
        updateGrandTotal();
    });

</script>

<script>
    //this script will generate object to send to the server side using ajax
    $('#saveButton').click(function () {
        if ((stockDamageList && stockDamageList.length > 0) || (deletedVouchers && deletedVouchers.length > 0)) {
            var cleanedStockDamageList = stockDamageList.map(obj => {
                const { TempId, ...rest } = obj; // here i am excluding the temp id as it is not needed

                // here making sure main things are correct such as voucher no shouldn't be string
                if (rest.VoucherNo === "" || rest.VoucherNo === null || rest.VoucherNo === undefined) {
                    rest.VoucherNo = null;
                } else {
                    rest.VoucherNo = parseInt(rest.VoucherNo);
                }

                if (!rest.BatchNo || rest.BatchNo <= 0) {
                    rest.BatchNo = null;
                } else {
                    rest.BatchNo = parseInt(rest.BatchNo);
                }

                if (rest.EmployeeId) rest.EmployeeId = parseInt(rest.EmployeeId) || null;

                return rest;
            });

            // creating one object to send into server side
            var dataToSend = {
                addedOrEditedStockDamages: cleanedStockDamageList,
                deletedVoucherNos: deletedVouchers
            };
            //console.log(JSON.stringify(dataToSend, null, 2)); //debugginf purpose code not needed

            $.ajax({
                url: '@Url.Action("SaveStockDamage", "StockDamage")', //it will send data to my action, controller path
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(dataToSend),
                success: function (response) {
                    alert('Data saved successfully!');
                    // after successfull data addtion it will referesh the page to view updated data
                    window.location.href = '@Url.Action("StockDamageMaintain", "StockDamage")';
                    console.log(response);
                },
                error: function (xhr, status, error) {
                    // any error message will show here also in console
                    console.error(xhr.responseText);
                    alert('Error saving data: ' + xhr.responseText);
                }
            });
        }
        else {
            alert("Nothing to change!")
        }
    });
</script>


<script>
    //this section will handle voucher search

    // this function works when clicked in the icon to search
    $('#searchWithVoucher').click(function () {
        var voucherNo = $('#voucherNo').val().trim();

        if (voucherNo === "") {
            alert("Please enter a Voucher Number to search.");
            return;
        }

        var found = false;

        //it will loop through all table rows and only show that row which voucher is matched
        $('#damageTable tbody tr').each(function () {
            var rowVoucherNo = $(this).find('td:last').text().trim(); //cause last column holds voucher number
            if (rowVoucherNo == voucherNo) {
                $(this).show(); // only show matched voucher
                found = true;
            } else {
                $(this).hide();// other voucher will be hidden
            }
        });

        if (!found) {
            alert("No data found for Voucher No: " + voucherNo);
        }
    });

    //here if user clears the voucher box, it will show all the row again
    $('#voucherNo').on('input', function () {
        var value = $(this).val().trim();
        if (value == "") {
            $('#damageTable tbody tr').show();
        }
    });
</script>


